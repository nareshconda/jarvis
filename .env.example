# =============================================================================
# Jarvis — configuration
#   1. cp .env.example .env        (or run:  python setup.py  — it writes this for you)
#   2. fill in what you use; everything you leave empty is simply turned off
#   3. NEVER commit .env — it is in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Assistant + server
# -----------------------------------------------------------------------------
JARVIS_ASSISTANT_NAME=Jarvis
JARVIS_WAKE_WORD=jarvis
JARVIS_TIMEZONE=Europe/London                # any tz database name, e.g. America/New_York
JARVIS_DEFAULT_LOCATION=London, United Kingdom   # fallback when GPS/IP location fails

JARVIS_HOST_IP=192.168.1.10                  # LAN IP of the machine running this server
JARVIS_HTTP_PORT=5006
JARVIS_HTTPS_PORT=5446
SSL_CERT_FILE=                               # e.g. /certs/cert.pem  (empty = no HTTPS)
SSL_KEY_FILE=                                # e.g. /certs/key.pem
JARVIS_PUBLIC_URL=                           # e.g. https://jarvis.example.com if you expose it
JARVIS_SECRET_KEY=change-me-to-a-long-random-string   # Flask session key (setup.py generates one)
JARVIS_DEFAULT_TIER=                         # mac | heavy | light | cloud  (empty = first configured)
JARVIS_REBUILD_CMD=                          # optional command for the UI "Reboot Me" button

# -----------------------------------------------------------------------------
# Users  (username:PIN pairs — use long PINs, this is your login)
# -----------------------------------------------------------------------------
JARVIS_USERS=alice:change-this-pin
JARVIS_USER_NAMES=alice:Alice                # how the assistant addresses each user
JARVIS_DEFAULT_USER=alice                    # owner: voice/phone/WhatsApp chats belong to them
JARVIS_OWNER_PROFILE=                        # optional: a sentence about you (job, interests)
JARVIS_API_TOKEN=change-me                   # phone shortcuts send header  X-Jarvis-Token: <this>

# -----------------------------------------------------------------------------
# Local LLM devices (Ollama). Up to 3 slots; leave a slot's IP empty to hide it.
#   DEVICE1 = your main GPU PC      (UI slot "heavy")
#   DEVICE2 = a second GPU PC       (UI slot "light")
#   MAC     = an Apple Silicon Mac  (UI slot "mac" — unified-memory juggling)
# Ollama must listen on the LAN:  OLLAMA_HOST=0.0.0.0  (see docs/DEVICES.md)
# -----------------------------------------------------------------------------
DEVICE1_NAME=Gaming PC
DEVICE1_SPECS=RTX 4070 Ti / 32 GB            # shown in the UI tooltip + startup banner
DEVICE1_IP=
DEVICE1_OLLAMA_URL=                          # default http://DEVICE1_IP:11434
DEVICE1_MODEL=qwen3.5:9b                     # "Better" text + vision
DEVICE1_FAST_MODEL=llama3.1:8b               # "Fast" text + vision
DEVICE1_CODE_MODEL=qwen2.5-coder:14b
DEVICE1_FAST_CODE_MODEL=qwen2.5-coder:7b
DEVICE1_ALIASES=gaming pc,main pc,heavy      # words that mean this PC in commands
DEVICE1_SSH_USER=                            # optional: copy generated files to the PC
DEVICE1_WAKE_HA_BUTTON=                      # optional: HA button that powers it on, e.g. button.gaming_pc_power
DEVICE1_WOL_MAC=                             # optional: Wake-on-LAN MAC, e.g. aa:bb:cc:dd:ee:ff
DEVICE1_SD_URL=                              # optional: Stable Diffusion API, default http://DEVICE1_IP:7860
DEVICE1_VIDEO_URL=                           # optional: ComfyUI for video, default http://DEVICE1_IP:8188
DEVICE1_VIDEO_ENGINE=freevideo               # freevideo (needs BF16: RTX 30xx+) | wan

DEVICE2_NAME=
DEVICE2_SPECS=
DEVICE2_IP=
DEVICE2_OLLAMA_URL=
DEVICE2_MODEL=qwen3.5:4b
DEVICE2_FAST_MODEL=llama3.2:3b
DEVICE2_CODE_MODEL=qwen2.5-coder:7b
DEVICE2_FAST_CODE_MODEL=qwen2.5-coder:1.5b
DEVICE2_ALIASES=second pc,light
DEVICE2_SSH_USER=
DEVICE2_WAKE_HA_BUTTON=
DEVICE2_WOL_MAC=
DEVICE2_SD_URL=
DEVICE2_VIDEO_URL=
DEVICE2_VIDEO_ENGINE=wan                     # RTX 20xx has no BF16 -> Wan 2.2 GGUF

MAC_NAME=
MAC_SPECS=
MAC_IP=
MAC_OLLAMA_URL=                              # default http://MAC_IP:11434
MAC_SSH_USER=                                # needed for `sudo purge` / GPU limit (docs/DEVICES.md)
MAC_FAST_MODEL=qwen3.5:9b                    # pinned in memory
MAC_VOICE_MODEL=llama3.2:latest              # pinned in memory (voice replies)
MAC_FAST_CODE_MODEL=qwen2.5-coder:7b
MAC_BETTER_MODEL=qwen3.5:27b                 # loaded alone after flushing the others
MAC_BETTER_NUM_CTX=16384
MAC_AGENT_MODEL=                             # e.g. qwen3.8:27b (vision agent); empty = MAC_FAST_CODE_MODEL
MAC_AGENT_NUM_CTX=16384
MAC_GPU_WIRED_MB=0                           # e.g. 20480 on a 24 GB Mac (lets the GPU use more RAM)
MAC_VIDEO_URL=                               # ComfyUI on the Mac, default http://MAC_IP:8188
MAC_VIDEO_ENGINE=freevideo
OLLAMA_MAC_VISION_MODEL=                     # optional separate vision model for the Mac
MAC_ALIASES=mac

OLLAMA_TIMEOUT=520
OLLAMA_NUM_CTX=8192
MAC_FAST_NUM_CTX=8192
MAC_VOICE_NUM_CTX=2048

# -----------------------------------------------------------------------------
# Cloud LLMs (any you leave empty are skipped)
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=                              # https://build.nvidia.com  (cloud "Better" seats + cloud agent)
GEMINI_API_KEY=                              # https://aistudio.google.com
GROQ_API_KEY=                                # https://console.groq.com  (fast intent router)
OPENAI_API_KEY=
HF_TOKEN=

CLOUD_LLM1_MODEL=deepseek-ai/deepseek-v4.1-flash
CLOUD_LLM2_MODEL=mistralai/mistral-large-4-1t-a52b
CLOUD_LLM3_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
CLOUD_AGENT_MODEL=mistralai/mistral-large-4-1t-a52b
AGENT_CLOUD_FALLBACKS=nvidia/nemotron-3.5-super-vl-120b-a12b,deepseek-ai/deepseek-v4.1-flash
AGENT_CLOUD_VISION=1                         # 1 = cloud agent sends screenshots to the VL model
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
ROUTER_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# PC agent (desktop control) — runs on each PC, see pc_agent/README.md
# -----------------------------------------------------------------------------
AGENT_TOKEN=change-me                        # SAME value in the PC agent's environment
AGENT_PORT=8765
AGENT_TARGETS=heavy,light                    # which PCs the agent may control
AGENT_HEAVY_MODEL=qwen3.5:9b                 # agent brain when "PC 1" is picked
AGENT_LIGHT_MODEL=qwen3.5:4b

# -----------------------------------------------------------------------------
# Voice (text-to-speech)
# -----------------------------------------------------------------------------
KOKORO_TTS_URL=                              # local Kokoro-FastAPI, e.g. http://192.168.1.20:8880
KOKORO_VOICE=bm_daniel
ELEVENLABS_API_KEY=                          # used when KOKORO_TTS_URL is empty
ELEVENLABS_VOICE_ID=
MIC_DEVICE_INDEX=-1

# -----------------------------------------------------------------------------
# Home Assistant
# -----------------------------------------------------------------------------
HOME_ASSISTANT_URL=                          # e.g. http://192.168.1.30:8123
HOME_ASSISTANT_TOKEN=                        # Profile > Security > Long-lived access token
HA_NOTIFY_SERVICE=                           # e.g. mobile_app_my_phone (push notifications)
HA_TODO_ENTITY=todo.jarvis_notes
HA_REMINDER_TODO=todo.jarvis_reminders
HA_CALENDAR_ENTITY=calendar.jarvis
HA_URL_PUBLIC=                               # header shortcut when away from home
# Spoken aliases / alarm lights live in config/home_assistant.json

# -----------------------------------------------------------------------------
# Stable Diffusion (AUTOMATIC1111 / Forge API — start it with --api --listen)
# -----------------------------------------------------------------------------
SD_API_KIND=a1111
SD_HEAVY_MODEL=                              # checkpoint name as listed in the SD UI
SD_LIGHT_MODEL=
SD_MAC_MODEL=
SD_STEPS=28
SD_WIDTH=1024
SD_HEIGHT=1024
SD_TIMEOUT=300

# -----------------------------------------------------------------------------
# Video (ComfyUI: FreeVideo / Wan 2.2) — see comfyui/README.md
# -----------------------------------------------------------------------------
VIDEO_WIDTH=960
VIDEO_HEIGHT=544
VIDEO_SECONDS=5
FREEVIDEO_TIMEOUT=1800
WAN_HIGH_GGUF=Wan2.2-T2V-A14B-HighNoise-Q4_K_M.gguf
WAN_LOW_GGUF=Wan2.2-T2V-A14B-LowNoise-Q4_K_M.gguf

# -----------------------------------------------------------------------------
# Nextcloud (notes, contacts, calendar, mail)
# -----------------------------------------------------------------------------
NC_BASE_URL=                                 # LAN address, e.g. http://192.168.1.20:8080
NC_PUBLIC_URL=                               # links shown in chat, e.g. https://cloud.example.com
NC_USER=
NC_APP_PASSWORD=                             # Nextcloud > Settings > Security > App passwords
NC_VERIFY_SSL=1                              # 0 only for a self-signed LAN certificate
NC_IMAP_HOST=
NC_IMAP_PORT=993
NC_IMAP_USER=
NC_IMAP_PASSWORD=

# -----------------------------------------------------------------------------
# Files + photos
# -----------------------------------------------------------------------------
FILE_SEARCH_ROOTS=                           # colon-separated folders, e.g. /mnt/data:/mnt/media
FILE_SEARCH_SSH_HOST=                        # or search over SSH: user@host (uses plocate there)
FILEBROWSER_URL=                             # optional File Browser link base
IMMICH_BASE_URL=                             # e.g. http://192.168.1.20:2283
IMMICH_EXTERNAL_URL=
IMMICH_API_KEY=

# -----------------------------------------------------------------------------
# Header shortcuts in the web UI (empty = hidden)
# -----------------------------------------------------------------------------
FILES_URL_LAN=                               # e.g. http://192.168.1.20:8080/apps/files
FILES_URL_PUBLIC=
DASHBOARD_URL_LAN=                           # e.g. a Homarr / Homepage dashboard
DASHBOARD_URL_PUBLIC=

# -----------------------------------------------------------------------------
# WhatsApp via Twilio (optional) — exposed with ngrok
# -----------------------------------------------------------------------------
TWILIO_AUTH_TOKEN=
WHATSAPP_ALLOWED_FROM=                       # whatsapp:+441234567890  (only this number is answered)
NGROK_AUTHTOKEN=
JARVIS_WHATSAPP_PORT=5010

# -----------------------------------------------------------------------------
# Surveillance (USB camera on the server, optional)
# -----------------------------------------------------------------------------
CAM_DEVICE=0
SECURITY_LIGHTS=                             # comma-separated HA lights to flash
SURVEILLANCE_DIR=./recordings

# -----------------------------------------------------------------------------
# Kubernetes (optional): mapping in config/k3s.json
# -----------------------------------------------------------------------------

# Chat database location (default ./jarvis.db)
JARVIS_DB_PATH=
MEMORY_DB_PATH=

# Home Assistant Ingress: requests from these IPs (your HA host) are trusted as the owner
JARVIS_TRUSTED_PROXY_IPS=
# Phones pushing GPS to /api/location send header X-Location-Token: <this>
JARVIS_LOCATION_TOKEN=
